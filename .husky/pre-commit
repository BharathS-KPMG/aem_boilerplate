# Calls node directly, not npx: npx is a bash script, and some git clients
# (GitHub Desktop's bundled git) have sh but no bash.
if [ ! -f node_modules/lint-staged/bin/lint-staged.js ]; then
  echo "lint-staged is not installed. Run: npm install" >&2
  exit 1
fi
node node_modules/lint-staged/bin/lint-staged.js "$@"
